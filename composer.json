{
	"name": "sombentur/searchpilot-pro",
	"description": "Autonomous technical SEO, indexing and search-performance suite for WordPress.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"SearchPilot\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SearchPilot\\Tests\\": "tests/unit/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:lite": "php tests/run.php",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
